#!/bin/bash
set -e

if ! command -v pass-cli &> /dev/null; then
    echo "pass-cli not found, skipping SSH agent setup"
    exit 0
fi

# Verify authentication
if ! pass-cli vault list &> /dev/null; then
    echo "⚠️  pass-cli not authenticated, skipping SSH agent setup"
    exit 0
fi

SOCKET_PATH="{{ .chezmoi.homeDir }}/.ssh/proton-pass-agent.sock"
LOG_FILE="{{ .chezmoi.homeDir }}/.local/state/proton-pass-ssh-agent.log"

mkdir -p "{{ .chezmoi.homeDir }}/.ssh"
mkdir -p "{{ .chezmoi.homeDir }}/.local/state"

{{ if eq .chezmoi.os "darwin" -}}
# Clean up legacy launchd service if present
launchctl bootout "gui/$(id -u)/me.proton.pass.ssh-agent" 2>/dev/null || true
rm -f "{{ .chezmoi.homeDir }}/Library/LaunchAgents/me.proton.pass.ssh-agent.plist"

# Stop any existing daemon before restarting
pass-cli ssh-agent daemon stop 2>/dev/null || true

# Start the daemon directly on macOS (launchd KeepAlive handles restarts)
pass-cli ssh-agent daemon start \
    --vault-name SSH \
    --socket-path "$SOCKET_PATH" \
    --log-file "$LOG_FILE"

echo "✓ Proton Pass SSH Agent daemon started"
echo "  Socket: $SOCKET_PATH"
echo "  Log: $LOG_FILE"
{{ else if eq .chezmoi.os "linux" -}}
# Clean up legacy systemd service if present
systemctl --user disable --now proton-pass-ssh-agent.service 2>/dev/null || true
rm -f "{{ .chezmoi.homeDir }}/.config/systemd/user/proton-pass-ssh-agent.service"
systemctl --user daemon-reload 2>/dev/null || true

# Enable and start the watcher service (it will start the daemon on first check)
systemctl --user daemon-reload
systemctl --user enable --now pass-ssh-agent-watcher.service

echo "✓ Proton Pass SSH Agent watcher service enabled"
echo "  Socket: $SOCKET_PATH"
echo "  Log: $LOG_FILE"
echo "  Watcher log: {{ .chezmoi.homeDir }}/.local/state/pass-ssh-agent-watcher.log"
{{ end -}}
