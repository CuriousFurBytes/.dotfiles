export EDITOR="hx"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_CACHE_HOME="$HOME/.cache"
export HOMEBREW_NO_ENV_HINTS=true

typeset -U path fpath
path=("$HOME/go/bin" $path "$HOME/.local/bin")
for zsh_functions_dir in \
    /opt/homebrew/share/zsh/functions \
    /usr/local/share/zsh/functions \
    /usr/share/zsh/functions; do
    [[ -d "$zsh_functions_dir" ]] && fpath=("$zsh_functions_dir" $fpath)
done
unset zsh_functions_dir

# zmodload zsh/zprof

# Antidote generates a static plugin bundle and only refreshes it when the
# plugin list changes. This keeps normal shell startup to a single source.
zsh_plugins="${ZDOTDIR:-$HOME}/.zsh_plugins"
zsh_plugins_txt="${zsh_plugins}.txt"
zsh_plugins_zsh="${zsh_plugins}.zsh"

for antidote_functions_dir in \
    "${ZDOTDIR:-$HOME}/.antidote/functions" \
    "$HOME/.antidote/functions" \
    /opt/homebrew/opt/antidote/share/antidote/functions \
    /usr/local/opt/antidote/share/antidote/functions; do
    if [[ -d "$antidote_functions_dir" ]]; then
        fpath=("$antidote_functions_dir" $fpath)
        autoload -Uz antidote
        break
    fi
done

if [[ -r "$zsh_plugins_txt" ]]; then
    if [[ ! "$zsh_plugins_zsh" -nt "$zsh_plugins_txt" ]]; then
        if (( $+functions[antidote] )); then
            antidote bundle <"$zsh_plugins_txt" >|"$zsh_plugins_zsh"
        elif [[ ! -r "$zsh_plugins_zsh" ]]; then
            print -u2 "antidote: install antidote to generate $zsh_plugins_zsh"
        fi
    fi

    [[ -r "$zsh_plugins_zsh" ]] && source "$zsh_plugins_zsh"
fi

unset antidote_functions_dir zsh_plugins zsh_plugins_txt zsh_plugins_zsh

# History
HISTSIZE=5000
HISTFILE="$HOME/.zsh_history"
SAVEHIST=$HISTSIZE
HISTDUP=erase
setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

# Completion styling
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls --color $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'ls --color $realpath'

autoload -Uz compinit
zcompdump_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
if [[ -d "$zcompdump_dir" ]] || mkdir -p "$zcompdump_dir" 2>/dev/null; then
    zcompdump="$zcompdump_dir/zcompdump"
    zmodload zsh/datetime 2>/dev/null
    zmodload -F zsh/stat b:zstat 2>/dev/null

    if (( $+builtins[zstat] )) && [[ -f "$zcompdump" ]] && (( EPOCHSECONDS - $(zstat +mtime "$zcompdump") < 86400 )); then
        compinit -C -d "$zcompdump"
    else
        compinit -d "$zcompdump"
    fi

    unset zcompdump
else
    compinit -C
fi
unset zcompdump_dir

# Pure
[[ -d "$HOME/.zsh/pure" ]] && fpath=("$HOME/.zsh/pure" $fpath)
zstyle ':prompt:pure:prompt:success'  color '#31748f'  # pine
zstyle ':prompt:pure:prompt:error'    color '#eb6f92'  # love
zstyle ':prompt:pure:path'            color '#ebbcba'  # rose
zstyle ':prompt:pure:git:branch'      color '#c4a7e7'  # iris
zstyle ':prompt:pure:git:dirty'       color '#f6c177'  # gold
zstyle ':prompt:pure:git:arrow'       color '#9ccfd8'  # foam
zstyle ':prompt:pure:git:stash'       color '#9ccfd8'  # foam
zstyle ':prompt:pure:execution_time'  color '#f6c177'  # gold
zstyle ':prompt:pure:virtualenv'      color '#6e6a86'  # muted
zstyle ':prompt:pure:user'            color '#908caa'  # subtle
zstyle ':prompt:pure:host'            color '#908caa'  # subtle
autoload -Uz promptinit
promptinit
if (( $+functions[prompt_pure_setup] )); then
    prompt pure
fi

# FZF
export FZF_DEFAULT_OPTS="
	--color=fg:#908caa,bg:#191724,hl:#ebbcba
	--color=fg+:#e0def4,bg+:#26233a,hl+:#ebbcba
	--color=border:#403d52,header:#31748f,gutter:#191724
	--color=spinner:#f6c177,info:#9ccfd8
	--color=pointer:#c4a7e7,marker:#eb6f92,prompt:#908caa"

__fzf_init() {
    (( ${+__FZF_LOADED} )) && return
    (( $+commands[fzf] )) || return

    __FZF_LOADED=1
    unset -f fzf 2>/dev/null
    eval "$(command fzf --zsh)"
}

if (( $+commands[fzf] )); then
    fzf() {
        __fzf_init
        command fzf "$@"
    }

    if (( $+functions[zsh-defer] )); then
        zsh-defer __fzf_init
    fi
fi

# Zoxide
__zoxide_init() {
    (( ${+__ZOXIDE_LOADED} )) && return
    (( $+commands[zoxide] )) || return

    __ZOXIDE_LOADED=1
    unset -f z zi 2>/dev/null
    eval "$(command zoxide init zsh)"
}

if (( $+commands[zoxide] )); then
    z() {
        __zoxide_init
        z "$@"
    }

    zi() {
        __zoxide_init
        zi "$@"
    }

    if (( $+functions[zsh-defer] )); then
        zsh-defer __zoxide_init
    fi
fi

# Mise
__mise_init() {
    (( ${+__MISE_LOADED} )) && return
    (( $+commands[mise] )) || return

    __MISE_LOADED=1
    unset -f mise 2>/dev/null
    eval "$(command mise activate zsh)"
}

if (( $+commands[mise] )); then
    mise() {
        __mise_init
        command mise "$@"
    }

    if (( $+functions[zsh-defer] )); then
        zsh-defer __mise_init
    fi
fi

# Worktrunk
__wt_init() {
    (( ${+__WT_LOADED} )) && return
    (( $+commands[wt] )) || return

    __WT_LOADED=1
    unset -f wt 2>/dev/null
    eval "$(command wt config shell init zsh)"
}

if (( $+commands[wt] )); then
    wt() {
        __wt_init
        command wt "$@"
    }

    if (( $+functions[zsh-defer] )); then
        zsh-defer __wt_init
    fi
fi

# Proton Pass SSH Agent
if command -v pass-cli >/dev/null 2>&1; then
    export SSH_AUTH_SOCK="$HOME/.ssh/proton-pass-agent.sock"
fi

# NPM
NPM_PACKAGES="$HOME/.npm-packages"
path=($path "$NPM_PACKAGES/bin")
export MANPATH="$NPM_PACKAGES/share/man:${MANPATH:-}"

# NVM
export NVM_DIR="$HOME/.nvm"

__nvm_load() {
    unset -f nvm node npm npx corepack yarn pnpm 2>/dev/null
    [[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
    [[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"
}

nvm() {
    __nvm_load
    nvm "$@"
}

node() {
    __nvm_load
    command node "$@"
}

npm() {
    __nvm_load
    command npm "$@"
}

npx() {
    __nvm_load
    command npx "$@"
}

corepack() {
    __nvm_load
    command corepack "$@"
}

yarn() {
    __nvm_load
    command yarn "$@"
}

pnpm() {
    __nvm_load
    command pnpm "$@"
}

# Adds alias commands
[[ -r "$HOME/.common_aliases" ]] && source "$HOME/.common_aliases"
[[ -r "$HOME/.bash_aliases" ]] && source "$HOME/.bash_aliases"

# zsh-patina should activate at the end so it sees the final ZLE setup.
if (( $+commands[zsh-patina] )); then
    eval "$(zsh-patina activate)"
fi

true
