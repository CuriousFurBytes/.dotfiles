# Base image for `sandbox` - runs with krun (VM isolation) by default.
#
# Includes: git, lazygit, gitscribe, uv, claude-code, codex, copilot-cli,
# gh, ripgrep, fd, fzf, jq, node 22, python 3.
#
# Rebuild via:
#   sandbox build     # just rebuild the image from this file
#   sandbox rebuild   # rebuild, then drop into the image to log in and
#                     # commit the authenticated state back on top

FROM fedora:41

ARG TARGETARCH=amd64

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TERM=xterm-256color \
    PATH=/home/dev/.local/bin:/home/dev/.cargo/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# ---------------------------------------------------------------------------
# System packages
# ---------------------------------------------------------------------------
RUN dnf -y install --setopt=install_weak_deps=False \
        git git-lfs openssh-clients gnupg2 ca-certificates \
        bash bash-completion zsh \
        curl wget tar xz unzip gzip bzip2 \
        fzf ripgrep fd-find jq bat \
        nodejs npm \
        python3 python3-pip \
        gh \
        make gcc gcc-c++ \
        which procps-ng iproute iputils \
        shadow-utils sudo \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# ---------------------------------------------------------------------------
# Non-root user matching your host UID/GID layout (--userns=keep-id maps the
# host user onto this one). If your UID differs, override at build time:
#   podman build --build-arg UID=1001 --build-arg GID=1001 ...
# ---------------------------------------------------------------------------
ARG UID=1000
ARG GID=1000
RUN groupadd -g "$GID" dev || true \
 && useradd -m -u "$UID" -g "$GID" -s /bin/bash dev \
 && echo 'dev ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/dev

# ---------------------------------------------------------------------------
# Tool installs as the dev user so their home-directory layouts (~/.cache,
# ~/.local/share, ~/.config) belong to the dev user.
# ---------------------------------------------------------------------------
USER dev
WORKDIR /home/dev

# uv (Astral's Python manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
 && mkdir -p /home/dev/.local/bin

# lazygit - latest release binary
RUN set -eux; \
    arch="$(uname -m)"; \
    case "$arch" in \
        x86_64)  lg_arch=x86_64 ;; \
        aarch64) lg_arch=arm64  ;; \
        *) echo "unsupported arch $arch"; exit 1 ;; \
    esac; \
    ver=$(curl -fsSL https://api.github.com/repos/jesseduffield/lazygit/releases/latest \
          | grep -oE '"tag_name":\s*"v[^"]+"' | head -1 | sed 's/.*"v//;s/"$//'); \
    curl -fsSL "https://github.com/jesseduffield/lazygit/releases/download/v${ver}/lazygit_${ver}_Linux_${lg_arch}.tar.gz" \
      | tar -xz -C /home/dev/.local/bin lazygit

# gitscribe (freeoss-space/gitscribe) - tries release asset first, falls back
# to `go install`. If you rebuild interactively and the binary is missing,
# install it however you like; the rebuild commit step will preserve it.
USER root
RUN dnf -y install golang || dnf -y install go-toolset || true
USER dev
RUN set -eux; \
    arch="$(uname -m)"; \
    case "$arch" in \
        x86_64)  gs_arch=x86_64 ;; \
        aarch64) gs_arch=arm64  ;; \
        *) gs_arch="$arch" ;; \
    esac; \
    mkdir -p /home/dev/.local/bin; \
    if ! curl -fsSL "https://github.com/freeoss-space/gitscribe/releases/latest/download/gitscribe_Linux_${gs_arch}.tar.gz" \
         | tar -xz -C /home/dev/.local/bin gitscribe 2>/dev/null; then \
        echo "gitscribe release asset not found; attempting 'go install'"; \
        GOBIN=/home/dev/.local/bin go install github.com/freeoss-space/gitscribe@latest || \
        echo "gitscribe install deferred - install manually during 'sandbox rebuild'"; \
    fi

# Claude Code, Codex CLI, GitHub Copilot CLI (all distributed via npm).
# Installed into the user's npm prefix so upgrades don't need root.
RUN npm config set prefix /home/dev/.local \
 && npm install -g \
        @anthropic-ai/claude-code \
        @openai/codex \
        @github/copilot

# Shell nicety: a tiny bashrc so interactive shells behave.
RUN printf '%s\n' \
    'export PATH=/home/dev/.local/bin:$PATH' \
    'export EDITOR=hx' \
    'alias ll="ls -la"' \
    'alias gs="git status"' \
    'alias lg="lazygit"' \
    'PS1="\[\e[36m\]sandbox\[\e[0m\]:\w$ "' \
    >> /home/dev/.bashrc

WORKDIR /workspace
CMD ["/bin/bash", "-l"]
